# Which LLM provider to use. One of: gemini, groq
LLM_PROVIDER=gemini

# Gemini API key (primary).
GEMINI_API_KEY=

# Groq API key (fallback for when Gemini quota runs out).
GROQ_API_KEY=

# Model names (override the defaults if needed).
GEMINI_MODEL=gemini-2.5-flash
GROQ_MODEL=llama-3.3-70b-versatile

# Run configuration
MAX_STEPS_PER_TASK=60
LLM_TEMPERATURE=0.3
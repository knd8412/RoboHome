# =========================================================================
# Project-specific
# =========================================================================
# Logs from agent runs (can be large)
logs/
*.log

# Eval output directory
eval_results/

# Temporary screen recordings
*.mp4
*.mov
*.gif
# but DO commit the official demo if we add one to examples/
!examples/demo.mp4
!examples/demo.gif

# Generated rendering artifacts
*.png
# but DO commit docs images and architecture diagrams
!docs/**/*.png
!examples/**/*.png

# Sample log files in examples/ are committed (jsonl), but not local runs
# (jsonl files outside examples/ are ignored by the logs/ rule above)

# Node (in case anyone vibes a JS tool into the repo)
node_modules/
package-lock.json
yarn.lock

# Jupyter (in case anyone uses a notebook for prototyping)
.ipynb_checkpoints/
*.ipynb

# Local notes scratchpad (your own; not for the team)
NOTES.md
TODO.md
scratch/